# Copy to .env (git-ignored) and adjust:  cp .env.example .env
# This file is for local development. Production settings: .env.production.example and README, Deployment.
# Read by: Docker Compose, the Spring Boot backend (spring.config.import) and Vite (only VITE_* keys reach the browser).
# Never commit .env. Never put a real secret in this example file.

# ---------------------------------------------------------------- PostgreSQL (Docker Compose + backend)
POSTGRES_USER=interviewer
# Use only letters, digits, '.', '_' and '-'. This file is read by two different parsers (Docker Compose and
# Spring's properties loader) that disagree about backslash, '$', '#' and quotes.
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=interviewer
# Optional, recommended outside development: a second role for the running application that can read and write rows but not
# change or drop tables (SECURITY.md, DB-1). POSTGRES_USER then only owns the schema and runs the migrations. Docker Compose creates
# the role when the database is first initialised (see docker/postgres/init); on an existing database, run db/ops/runtime-grants.sql.
# Leave both empty to use POSTGRES_USER for everything, as on a developer's machine.
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=
# TLS to the database: prefer (default), require, verify-full. The prod profile defaults to require.
# POSTGRES_SSLMODE=prefer
POSTGRES_HOST=localhost
# Change the host port if 5432 is already used by a local PostgreSQL.
POSTGRES_PORT=5432
# A full JDBC URL instead of host, port and database (without the user and password, which stay in the variables above).
# Example for Neon: jdbc:postgresql://ep-example-123456.eu-central-1.aws.neon.tech/interviewer?sslmode=require
# JDBC_DATABASE_URL=

# ---------------------------------------------------------------- Backend (Spring Boot)
# The Spring profile is NOT chosen here: a key in this imported file is not an environment variable, so
# SPRING_PROFILES_ACTIVE would be silently ignored. Select it on the command line instead:
#   local (Swagger UI + plain-text logs):  ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#   prod  (no Swagger UI, JSON logs):      SPRING_PROFILES_ACTIVE=prod java -jar target/tech-interviewer-<version>.jar
# If you change the port, the Vite dev server proxy and `pnpm gen:api` follow it automatically.
SERVER_PORT=8080
# Hosting platforms set PORT for the container; it is used when SERVER_PORT is not set.
# PORT=8080
# Comma-separated browser origins allowed to call the API (CORS). Each one is scheme://host[:port]:
# no path, no trailing slash, no wildcard. Required in the prod profile.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# SameSite of the refresh cookie: Lax (default) when the app and the API share a site (one domain, or one origin behind a
# proxy); None when they are on two sites, such as *.pages.dev and *.run.app (Safari still blocks it there: README, Deployment).
# APP_REFRESH_COOKIE_SAME_SITE=Lax

# ---------------------------------------------------------------- Authentication
# REQUIRED outside the local profile: the backend refuses to start without a usable JWT_SECRET.
# Base64 of at least 32 random bytes. Generate with:  openssl rand -base64 48
# In the local profile (./mvnw spring-boot:run -Dspring-boot.run.profiles=local) an empty value is fine: a random
# throw-away key is generated (with a WARN log) and access tokens stop working at every restart.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d

# ---------------------------------------------------------------- AI layer (AI_ARCHITECTURE.md)
# Off by default: the interview runs, but questions, evaluations and narratives answer "AI unavailable".
# On: every AI task must reach a configured provider, or the backend refuses to start (the prod profile turns it on).
AI_ENABLED=false
# Gemini (the production provider). Create a key at https://aistudio.google.com/apikey. Never commit it.
GEMINI_API_KEY=
# Models (optional). GEMINI_MODEL serves questions, evaluation and the report; GEMINI_FAST_MODEL serves follow-ups.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Optional local provider. Install from https://ollama.com and pull a model (ollama pull qwen3.5:4b); the
# local-ollama Spring profile routes every task to it. OLLAMA_ENABLED alone only registers the provider.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
# Model used by the local-ollama profile.
OLLAMA_MODEL=qwen3.5:4b
# Embedding model of the local-ollama profile (ollama pull embeddinggemma).
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Context window (num_ctx), prompt and answer together. Ollama's own default of 4096 cuts long evaluations short.
OLLAMA_CONTEXT_WINDOW=16384

# ---------------------------------------------------------------- RAG (RAG_ARCHITECTURE.md; active only with AI_ENABLED=true)
# Ground questions, evaluations, follow-ups and reports in the curated knowledge base.
RAG_ENABLED=true
# Gemini embedding model (768 dimensions are requested).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Cosine similarity a chunk found only by meaning needs; depends on the embedding model. Uncomment to override the
# default (0.30, measured for embeddinggemma).
# RAG_MIN_SIMILARITY=0.30
# Cosine similarity from which a generated question counts as a repeat of an earlier one (semantic de-duplication).
# Defaults: 0.90 for gemini-embedding-2, 0.80 for embeddinggemma (both measured). Uncomment to override.
# RAG_DEDUP_MIN_SIMILARITY=0.90

# ---------------------------------------------------------------- Frontend (Vite; VITE_ prefix = public, never put secrets here)
# Leave empty in development: requests to /api are proxied to the backend.
# Set to the backend's public URL for a production build (e.g. https://api.example.com).
VITE_API_BASE_URL=
# Optional override for where the dev server proxies /api to. Leave blank to use http://localhost:<SERVER_PORT>.
VITE_DEV_API_PROXY_TARGET=

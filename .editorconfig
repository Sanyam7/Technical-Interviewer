root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml,sql,properties}]
indent_size = 4

[{pom.xml,mvnw}]
# Generated by Spring Initializr and the Maven wrapper; keep their native tab indentation.
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

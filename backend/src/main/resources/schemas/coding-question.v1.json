{
  "type": "object",
  "description": "One coding problem with its examples and the key points a good solution contains.",
  "properties": {
    "topic": {
      "type": "string",
      "description": "The requested topic key, copied exactly, or none when no topic was requested."
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "The requested difficulty level, copied exactly."
    },
    "prompt": {
      "type": "string",
      "description": "The problem statement as the candidate will read it, 40 to 2000 characters."
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "expectedKeyPoints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "description": "What a strong solution does (approach, complexity, edge cases); never shown to the candidate.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" }
        },
        "required": ["id", "text"],
        "additionalProperties": false
      }
    },
    "coding": {
      "type": "object",
      "properties": {
        "constraints": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string" },
          "description": "Input limits, for example 1 <= n <= 10^5."
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "input": { "type": "string" },
              "output": { "type": "string" },
              "explanation": { "type": ["string", "null"] }
            },
            "required": ["input", "output", "explanation"],
            "additionalProperties": false
          }
        },
        "starterSignature": {
          "type": ["string", "null"],
          "description": "A function signature in the required language, or null."
        }
      },
      "required": ["constraints", "examples", "starterSignature"],
      "additionalProperties": false
    }
  },
  "required": ["topic", "difficulty", "prompt", "estimatedMinutes", "expectedKeyPoints", "coding"],
  "additionalProperties": false
}

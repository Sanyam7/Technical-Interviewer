{
  "id": "search-rotated-array",
  "title": "Search in Rotated Sorted Array",
  "difficulty": 4,
  "statement": "An array of distinct integers sorted in ascending order was rotated at an unknown pivot: for example `[0,1,2,4,5,6,7]` may have become `[4,5,6,7,0,1,2]`.\n\nGiven the rotated array `nums` and an integer `target`, return the index of `target` in `nums`, or `-1` if it is not there. Aim for O(log n) time.",
  "constraints": [
    "1 <= nums.length <= 10^5",
    "-10^4 <= nums[i] <= 10^4",
    "All values of nums are distinct",
    "nums is an ascending array, possibly rotated"
  ],
  "signature": {
    "name": "search",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      },
      {
        "name": "target",
        "type": "int"
      }
    ],
    "returns": "int"
  },
  "comparison": "EXACT",
  "timeLimitMs": 2000,
  "complexity": {
    "time": "O(log n)",
    "space": "O(1)"
  },
  "keyPoints": [
    {
      "id": "kp1",
      "text": "Uses binary search: at least one half around the middle is always sorted"
    },
    {
      "id": "kp2",
      "text": "Decides which half to keep by checking whether the target lies inside the sorted half"
    },
    {
      "id": "kp3",
      "text": "Handles an unrotated array, arrays of one or two elements and a missing target"
    }
  ],
  "tests": [
    {"name": "Example 1", "category": "EXAMPLE", "args": [[4, 5, 6, 7, 0, 1, 2], 0], "expected": 4},
    {"name": "Example 2", "category": "EXAMPLE", "args": [[4, 5, 6, 7, 0, 1, 2], 3], "expected": -1, "explanation": "3 is not in the array."},
    {"name": "target in the left half", "category": "GENERAL", "args": [[6, 7, 8, 1, 2, 3, 4, 5], 7], "expected": 1},
    {"name": "target in the right half", "category": "GENERAL", "args": [[6, 7, 8, 1, 2, 3, 4, 5], 4], "expected": 6},
    {"name": "pivot near the end", "category": "GENERAL", "args": [[2, 3, 4, 5, 6, 7, 8, 1], 1], "expected": 7},
    {"name": "single element missing", "category": "EDGE", "args": [[1], 0], "expected": -1},
    {"name": "two elements", "category": "EDGE", "args": [[3, 1], 1], "expected": 1},
    {"name": "not rotated", "category": "EDGE", "args": [[1, 2, 3, 4, 5], 5], "expected": 4},
    {"name": "large array", "category": "PERFORMANCE", "args": [{"$concat": [{"$range": [50000, 99999]}, {"$range": [0, 49999]}]}, 49999], "expected": 99999}
  ]
}

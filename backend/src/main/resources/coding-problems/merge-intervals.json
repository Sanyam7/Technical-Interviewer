{
  "id": "merge-intervals",
  "title": "Merge Intervals",
  "difficulty": 3,
  "statement": "Given an array of `intervals` where `intervals[i] = [start, end]`, merge all overlapping intervals and return the merged intervals sorted by their start.\n\nIntervals that touch, such as `[1,4]` and `[4,5]`, overlap.",
  "constraints": [
    "1 <= intervals.length <= 10^4",
    "intervals[i].length == 2",
    "0 <= start <= end <= 10^4"
  ],
  "signature": {
    "name": "merge",
    "params": [
      {
        "name": "intervals",
        "type": "int[][]"
      }
    ],
    "returns": "int[][]"
  },
  "comparison": "EXACT",
  "timeLimitMs": 2000,
  "complexity": {
    "time": "O(n log n)",
    "space": "O(n)"
  },
  "keyPoints": [
    {
      "id": "kp1",
      "text": "Sorts the intervals by start before merging"
    },
    {
      "id": "kp2",
      "text": "Extends the last merged interval when the next one starts at or before its end, using the larger end"
    },
    {
      "id": "kp3",
      "text": "Handles touching and fully nested intervals"
    }
  ],
  "tests": [
    {"name": "Example 1", "category": "EXAMPLE", "args": [[[1, 3], [2, 6], [8, 10], [15, 18]]], "expected": [[1, 6], [8, 10], [15, 18]], "explanation": "[1,3] and [2,6] overlap and become [1,6]."},
    {"name": "Example 2", "category": "EXAMPLE", "args": [[[1, 4], [4, 5]]], "expected": [[1, 5]]},
    {"name": "unsorted input", "category": "GENERAL", "args": [[[8, 10], [1, 3], [2, 6]]], "expected": [[1, 6], [8, 10]]},
    {"name": "no overlap", "category": "GENERAL", "args": [[[1, 2], [3, 4], [5, 6]]], "expected": [[1, 2], [3, 4], [5, 6]]},
    {"name": "chain of overlaps", "category": "GENERAL", "args": [[[1, 4], [2, 5], [5, 7], [9, 9]]], "expected": [[1, 7], [9, 9]]},
    {"name": "single interval", "category": "EDGE", "args": [[[5, 5]]], "expected": [[5, 5]]},
    {"name": "nested interval", "category": "EDGE", "args": [[[1, 10], [2, 3], [4, 5]]], "expected": [[1, 10]]},
    {"name": "identical intervals", "category": "EDGE", "args": [[[2, 3], [2, 3]]], "expected": [[2, 3]]}
  ]
}

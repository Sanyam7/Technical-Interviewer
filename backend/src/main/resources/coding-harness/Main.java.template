// Test harness for a Java solution. Generated per run; runs inside the sandbox container next to Solution.java.
// Protocol (one line each, prefixed with the run's nonce): RESULT <index> <OK|ERROR|TIMEOUT> <millis> <json>, then DONE.
// It reports what the function returned; the expected outputs are not in the container and are compared by the server.
import java.io.FileDescriptor;
import java.io.FileOutputStream;
import java.io.PrintStream;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.Collection;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public final class Main {

    private static final PrintStream OUT = new PrintStream(new FileOutputStream(FileDescriptor.out), true, StandardCharsets.UTF_8);
    private static final long TIME_LIMIT_MS = __TIME_LIMIT_MS__L;
    private static String nonce = "";

    private Main() {
    }

    @SuppressWarnings("unchecked")
    public static void main(String[] args) throws Exception {
        nonce = args[0];
        List<Object> tests = (List<Object>) new Json(Files.readString(Path.of("input.json"), StandardCharsets.UTF_8)).value();
        for (int i = 0; i < tests.size(); i++) {
            List<Object> arguments = (List<Object>) ((Map<String, Object>) tests.get(i)).get("args");
            Object[] box = new Object[3];
            Thread worker = new Thread(null, () -> {
                long start = System.nanoTime();
                try {
                    box[0] = render(call(arguments));
                } catch (Throwable failure) {
                    box[1] = describe(failure);
                }
                box[2] = (System.nanoTime() - start) / 1_000_000L;
            }, "test-" + i, 64L << 20);
            worker.setDaemon(true);
            worker.start();
            worker.join(TIME_LIMIT_MS);
            if (worker.isAlive()) {
                // A thread cannot be stopped safely: report the timeout and end the process; later tests are not run.
                emit(i, "TIMEOUT", TIME_LIMIT_MS, "null");
                OUT.println(nonce + " DONE");
                Runtime.getRuntime().halt(0);
            }
            long millis = box[2] == null ? 0 : (Long) box[2];
            if (box[1] != null) {
                emit(i, "ERROR", millis, quote((String) box[1]));
            } else {
                emit(i, "OK", millis, (String) box[0]);
            }
        }
        OUT.println(nonce + " DONE");
        Runtime.getRuntime().halt(0);
    }

    private static Object call(List<Object> a) {
        __CALL__
    }

    private static void emit(int index, String status, long millis, String payload) {
        OUT.println(nonce + " RESULT " + index + " " + status + " " + millis + " " + payload);
    }

    private static String describe(Throwable failure) {
        StringBuilder text = new StringBuilder(failure.getClass().getSimpleName());
        if (failure.getMessage() != null) {
            text.append(": ").append(failure.getMessage());
        }
        for (StackTraceElement frame : failure.getStackTrace()) {
            if (frame.getClassName().startsWith("Solution")) {
                text.append(" (Solution.java line ").append(frame.getLineNumber()).append(')');
                break;
            }
        }
        return text.length() <= 300 ? text.toString() : text.substring(0, 300);
    }

    // ---- conversion of the arguments ------------------------------------------------------------------------------

    static int toInt(Object value) {
        return ((Long) value).intValue();
    }

    static long toLong(Object value) {
        return (Long) value;
    }

    static boolean toBoolean(Object value) {
        return (Boolean) value;
    }

    static String toStr(Object value) {
        return (String) value;
    }

    @SuppressWarnings("unchecked")
    static int[] toIntArray(Object value) {
        List<Object> list = (List<Object>) value;
        int[] array = new int[list.size()];
        for (int i = 0; i < array.length; i++) {
            array[i] = toInt(list.get(i));
        }
        return array;
    }

    @SuppressWarnings("unchecked")
    static String[] toStringArray(Object value) {
        List<Object> list = (List<Object>) value;
        String[] array = new String[list.size()];
        for (int i = 0; i < array.length; i++) {
            array[i] = (String) list.get(i);
        }
        return array;
    }

    @SuppressWarnings("unchecked")
    static int[][] toIntMatrix(Object value) {
        List<Object> list = (List<Object>) value;
        int[][] matrix = new int[list.size()][];
        for (int i = 0; i < matrix.length; i++) {
            matrix[i] = toIntArray(list.get(i));
        }
        return matrix;
    }

    // ---- the result as JSON -----------------------------------------------------------------------------------------

    static String render(Object value) {
        StringBuilder out = new StringBuilder();
        write(out, value);
        return out.toString();
    }

    private static void write(StringBuilder out, Object value) {
        if (value == null) {
            out.append("null");
        } else if (value instanceof Number || value instanceof Boolean) {
            out.append(value);
        } else if (value instanceof String || value instanceof Character) {
            out.append(quote(value.toString()));
        } else if (value instanceof int[] array) {
            List<Object> list = new ArrayList<>();
            for (int element : array) {
                list.add(element);
            }
            write(out, list);
        } else if (value instanceof long[] array) {
            List<Object> list = new ArrayList<>();
            for (long element : array) {
                list.add(element);
            }
            write(out, list);
        } else if (value instanceof boolean[] array) {
            List<Object> list = new ArrayList<>();
            for (boolean element : array) {
                list.add(element);
            }
            write(out, list);
        } else if (value instanceof Object[] array) {
            write(out, List.of(array));
        } else if (value instanceof Collection<?> collection) {
            out.append('[');
            boolean first = true;
            for (Object element : collection) {
                if (!first) {
                    out.append(',');
                }
                first = false;
                write(out, element);
            }
            out.append(']');
        } else {
            out.append(quote(value.toString()));
        }
    }

    static String quote(String text) {
        StringBuilder out = new StringBuilder("\"");
        for (int i = 0; i < text.length(); i++) {
            char c = text.charAt(i);
            switch (c) {
                case '"' -> out.append("\\\"");
                case '\\' -> out.append("\\\\");
                case '\n' -> out.append("\\n");
                case '\r' -> out.append("\\r");
                case '\t' -> out.append("\\t");
                default -> {
                    if (c < 0x20) {
                        out.append(String.format("\\u%04x", (int) c));
                    } else {
                        out.append(c);
                    }
                }
            }
        }
        return out.append('"').toString();
    }

    /** A small JSON reader for the test inputs: objects, arrays, strings, integers, booleans and null. */
    static final class Json {

        private final String text;
        private int position;

        Json(String text) {
            this.text = text;
        }

        Object value() {
            skip();
            char c = text.charAt(position);
            if (c == '{') {
                return object();
            }
            if (c == '[') {
                return array();
            }
            if (c == '"') {
                return string();
            }
            if (text.startsWith("true", position)) {
                position += 4;
                return Boolean.TRUE;
            }
            if (text.startsWith("false", position)) {
                position += 5;
                return Boolean.FALSE;
            }
            if (text.startsWith("null", position)) {
                position += 4;
                return null;
            }
            int start = position;
            if (c == '-') {
                position++;
            }
            while (position < text.length() && Character.isDigit(text.charAt(position))) {
                position++;
            }
            return Long.parseLong(text.substring(start, position));
        }

        private Map<String, Object> object() {
            Map<String, Object> map = new LinkedHashMap<>();
            position++;
            skip();
            if (text.charAt(position) == '}') {
                position++;
                return map;
            }
            while (true) {
                skip();
                String key = string();
                skip();
                position++; // ':'
                map.put(key, value());
                skip();
                if (text.charAt(position++) == '}') {
                    return map;
                }
            }
        }

        private List<Object> array() {
            List<Object> list = new ArrayList<>();
            position++;
            skip();
            if (text.charAt(position) == ']') {
                position++;
                return list;
            }
            while (true) {
                list.add(value());
                skip();
                if (text.charAt(position++) == ']') {
                    return list;
                }
            }
        }

        private String string() {
            StringBuilder out = new StringBuilder();
            position++;
            while (true) {
                char c = text.charAt(position++);
                if (c == '"') {
                    return out.toString();
                }
                if (c != '\\') {
                    out.append(c);
                    continue;
                }
                char escaped = text.charAt(position++);
                switch (escaped) {
                    case 'n' -> out.append('\n');
                    case 'r' -> out.append('\r');
                    case 't' -> out.append('\t');
                    case 'b' -> out.append('\b');
                    case 'f' -> out.append('\f');
                    case 'u' -> {
                        out.append((char) Integer.parseInt(text.substring(position, position + 4), 16));
                        position += 4;
                    }
                    default -> out.append(escaped);
                }
            }
        }

        private void skip() {
            while (position < text.length() && Character.isWhitespace(text.charAt(position))) {
                position++;
            }
        }
    }
}

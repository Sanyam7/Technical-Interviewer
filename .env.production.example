# Production settings for the self-hosted stack (docker-compose.prod.yml). For hosted platforms, set the same names as
# environment variables or secrets of the service (README, Deployment). Copy, fill in, never commit:
#   cp .env.production.example .env.production
# Values: letters, digits and . _ - only, no quotes or spaces (read by Docker Compose and by Spring).

# ---------------------------------------------------------------- Site
# REQUIRED. The domain the site is served on; Caddy obtains its TLS certificate (DNS must point at this machine first).
# Use :80 to try the stack on your own machine over plain http (http://localhost).
SITE_ADDRESS=interviewer.example.com
# REQUIRED. The site's URL as the browser sees it (scheme://host, no path, no trailing slash). http://localhost when trying it out.
APP_CORS_ALLOWED_ORIGINS=https://interviewer.example.com

# ---------------------------------------------------------------- Database
POSTGRES_USER=interviewer
# REQUIRED. Owner of the schema; runs the migrations. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=interviewer
# REQUIRED. The role the application connects as: rows only, no schema changes (SECURITY.md DB-1).
POSTGRES_APP_USER=interviewer_app
# REQUIRED. Generate: openssl rand -hex 24
POSTGRES_APP_PASSWORD=

# ---------------------------------------------------------------- Authentication
# REQUIRED. Signs the access tokens. Base64 of at least 32 random bytes: openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------- AI (Gemini)
# REQUIRED unless AI_ENABLED=false. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names are configuration, not code. GEMINI_MODEL: questions, evaluation, report; GEMINI_FAST_MODEL: follow-ups.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# false runs the interview without AI (questions and evaluations answer "AI unavailable"): only for trying the stack out.
AI_ENABLED=true
